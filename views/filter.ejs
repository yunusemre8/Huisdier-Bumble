<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isPageTitle %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <h1><%= isPageTitle %></h1>
        <p>Find the perfect play buddy for your pet based on your interests and preferences</p>
    </header>

    <div class="page">

        <aside class="sidebar" id="sidebar">
            <h2>Filters</h2>
            <button id="close-button">X</button>

            <section>
                <label>Pet Type</label>
                <button class="type-btn" data-type="dog">Dog</button>
                <button class="type-btn" data-type="cat">Cat</button>
            </section>

            <section>
                <label>Breed</label>
                <div class="chip-group">
                    <% dogBreeds.forEach(breed => { %>
                        <button class="chip"><%= breed %></button>
                    <% }) %>
                </div>
            </section>

            <section>
                <label>Size</label>
                <div class="chip-group">
                    <button class="chip">Small</button>
                    <button class="chip">Medium</button>
                    <button class="chip">Large</button>
                </div>
            </section>

            <button id="apply-btn">Show Results</button>
        </aside>

        <main>
            <button id="open-btn">Filters</button>
            <div id="results"></div>
        </main>

    </div>

  <script src="/filter.js"></script>

</body>
</html>