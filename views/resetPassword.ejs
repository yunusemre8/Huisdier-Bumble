<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset password</title>
    <meta name="description" content="reset password page">
    <link rel="stylesheet" href="/style.css">
</head>
<body id="page-reset">
    <h1>Reset password</h1>

    <% if (message) { %>
        <div class="<%= message.type %>">
            <%= message.text %>
        </div>
    <% } %>

    <form action="/resetPassword" method="POST">
        <label for="resetUserEmail">Email</label>
        <input type="email" name="resetUserEmail" id="resetUserEmail" required>

        <label for="resetPetName">Pet name</label>
        <input type="text" name="resetPetName" id="resetPetName" required>

        <label for="resetPetWeight">Pet weight (kg)</label>
        <input type="number" step="0.1" name="resetPetWeight" id="resetPetWeight" required>

        <label for="resetNewPassword">New password</label>
        <input type="password" name="resetNewPassword" id="resetNewPassword" required>

        <label for="confirmResetNewPassword">Confirm new password</label>
        <input type="password" name="confirmResetNewPassword" id="confirmResetNewPassword" required>

        <button type="submit">Reset password</button>
    </form>

</body>
</html>