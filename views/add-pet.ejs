<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Huisdier toevoegen</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="/profile.css">
</head>
<body>
    <div class="card">
        <h1>Huisdier toevoegen</h1>

        <form action="/add-pet/<%= userId %>" method="POST" enctype="multipart/form-data">

            <div class="form-group">
                <label>Naam huisdier</label>
                <input type="text" name="petName" required>
            </div>

            <div class="form-group">
                <label>Soort dier</label>
                <select name="petType">
                    <option value="cat">Kat</option>
                    <option value="dog">Hond</option>
                </select>
            </div>

            <div class="form-group">
                <label>Ras</label>
                <input type="text" name="isBreed">
            </div>

            <div class="form-group">
                <label>Gewicht (kg)</label>
                <input type="number" name="isKilo" step="0.1">
            </div>

            <div class="form-group">
                <label>Foto</label>
                <input type="file" name="cover" accept="image/*">
            </div>

            <div class="actions">
                <button type="submit">Toevoegen</button>
                <a href="/profile/<%= userId %>">Annuleren</a>
            </div>

        </form>
    </div>
</body>
</html>