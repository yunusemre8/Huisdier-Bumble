<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your matches</title>
  <link rel="stylesheet" href="/yourmatches.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body>
  <main class="matches-page">
    <section class="phone-screen">
      <p class="small-title">your matches</p>

      <section class="matches-card">
        <h1>Your matches</h1>

        <article class="match-item">
          <button class="remove-btn">X</button>

          <div class="match-left">
            <img src="/images/sophie 2.png" alt="Sophie" class="match-image" />

            <div class="match-info">
              <h2>Sophie</h2>
              <p>Dog mom 🐶</p>
              <p>Age: 28</p>
            </div>
          </div>

          <div class="heart-button">♥</div>
        </article>

        <article class="match-item">
          <button class="remove-btn">X</button>

          <div class="match-left">
            <img src="/images/emmaprofiel 2.png" alt="Emma" class="match-image" />

            <div class="match-info">
              <h2>Emma</h2>
              <p>Dog mom 🐶</p>
              <p>Age 31</p>
            </div>
          </div>

          <div class="heart-button">♥</div>
        </article>

        <article class="match-item">
          <button class="remove-btn">X</button>

          <div class="match-left">
            <img src="/images/Mark 2.png" alt="Mark" class="match-image" />

            <div class="match-info">
              <h2>Mark</h2>
              <p>Dog dad 🐶</p>
              <p>Age 32</p>
            </div>
          </div>

          <div class="heart-button">♥</div>
        </article>

        <article class="match-item">
          <button class="remove-btn">X</button>

          <div class="match-left">
            <img src="/images/Dean 2.png" alt="Dean" class="match-image" />

            <div class="match-info">
              <h2>Dean</h2>
              <p>Dog dad 🐶</p>
              <p>Age 26</p>
            </div>
          </div>

          <div class="heart-button">♥</div>
        </article>
      </section>

      <nav class="bottom-nav">
        <a href="/" class="nav-icon">☝</a>
        <a href="/contact" class="nav-icon">💬</a>
        <a href="/profile/test" class="nav-icon">◯</a>
      </nav>
    </section>
  </main>
</body>
</html>