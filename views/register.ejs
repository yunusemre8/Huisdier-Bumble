<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <meta name="description" content="Sign up page">
    <link rel="stylesheet" href="/style.css">
</head>

<body id="page-register">
    <div class="welcome">
        <h1>Sign up</h1>
        <h2>Welcome</h2>
        <p class="welcome-text">How lovely that you chose Pet-Playdates for your furry friend.</p>
        <p class="welcome-text"> Signing up takes less than 3 minutes.</p>
    </div>

    <form action="/register" method="POST" enctype="multipart/form-data">

        <div class="progress-bar">
            <div class="progress-fill" id="progressFill"></div>
        </div>

        <fieldset class="firstQuestionsBox">
            <legend>First things first: what is your name?</legend>

            <div class="name-input">
                <label for="userName"></label>
                <input type="text" name="userName" placeholder="Your name" required>
                <span class="paw-icon">🐾</span>
            </div>

            <label for="userAge">Your Birthday</label>
            <p id="ageWarning">Pet Playdates is for users aged 18+ only.</p>
            <input type="date" name="userAge" id="userAge" required>

            <button type="button" id="button1">Next</button>
        </fieldset>

        <fieldset class="secondQuestionsBox">
            <legend>About your furry friend</legend>
            <label for="petName">Pet Name</label>
            <input type="text" name="petName">

            <label for="petType">Choose your animal and breed</label>
            <div class="typeFlex">
                <select name="petType" id="petType" required>
                    <option value="cat" selected>Cat</option>
                    <option value="dog">Dog</option>
                </select>
                <select name="isBreed" id="isBreed">
                    <option value="Select a breed" required></option>
                </select>
            </div>

            <label for="petAge">Pet's Age</label>
            <div class="button-row">
                <input type="number" name="petBirthYear" id="isAgeYear" placeholder="Birth Year">
                <!-- PS for us: Javascript calculates months and matches according to months -->
                <input type="number" name="petBirthMonth" id="isAgeMonth" placeholder="Birth Month">
            </div>

            <div class="button-row">
                <button type="button" id="button21">Back</button>
                <button type="button" id="button2">Next</button>
            </div>
        </fieldset>

        <fieldset class="thirdQuestionsBox">
            <legend>About your furry friend</legend>

            <label for="isKilo">Weight</label>
            <input type="number" name="isKilo" step="0.1"><span>kilogram</span>

            <label>Is your pet vaccinated?</label>

            <div class="button-row">
                <span>Yes</span><input class="radiobutton" type="radio" name="isVaccinated" value="yes">
                <span>No</span><input class="radiobutton" type="radio" name="isVaccinated" value="no">
            </div>

            <label>Your pet is...</label>
            <div class=button-row>
                <span>Castrated</span><input class=radiobutton type="radio" name="isCastrated" value="yes">
                <span>Not yet castrated</span><input class=radiobutton type="radio" name="isCastrated" value="no">
            </div>

            <label>Picture of your pet</label>
            <input name="cover" type="file" accept="image/*">

            <div class="button-row">
                <button type="button" id="button31">Back</button>
                <button type="button" id="button3">Next</button>
            </div>
        </fieldset>

        <fieldset class="fourthQuestionsBox">

            <legend>About you</legend>
            <p>It's not just about pets -your experience matters too!</p>

            <label for="userCity">Which city do you live in?</label>
            <input type="text" name="userCity" id="userCity" required>

            <label for="isFrequency">How often would you like playdates?</label>

            <select name="isFrequency" id="isFrequency">
                <option value="weekly">Weekly</option>
                <option value="everyFewWeeks">Every few weeks</option>
                <option value="occasionally">Occasionally</option>
                <option value="flexibel">Flexibel</option>
            </select>

            <label for="preferPlace">Where do you prefer meeting? </label>
            <p>We suggest first meet in a public space.</p>

            <select name="preferPlace" id="preferPlace">
                <option value="isOutdoor">Outdoor</option>
                <option value="isGarden">A closed garden</option>
                <option value="isHome">At home</option>
                <option value="isCafe">A pet friendly cafe</option>
            </select>

            <div class="button-row">
                <button type="button" id="button41">Back</button>
                <button type="button" id="button4">Next</button>
            </div>
        </fieldset>

        <fieldset class="fifthQuestionsBox">

            <label for="preferContact">How would you like to get in touch with your matches?</label>
            <div class="button-row">
                <span>via e-mail</span>
                <input class="radiobutton" type="radio" name="preferContact" id="preferEmail" value="email">
                <span>via Whatsapp</span>
                <input class="radiobutton" type="radio" name="preferContact" id="isWhatsapp" value="whatsapp">
            </div>

            <div id="isPhone">
                <span>Type your phone number</span>
                <input type="tel" name="userPhone" id="userPhone">
            </div>

            <label for="userEmail">Your email address</label>
            <input type="email" name="userEmail" id="userEmail" required>

            <label for="isPassword">Create your password</label>
            <input type="password" id="isPassword" name="isPassword" required>
            <input type="password" id="checkPassword" name="checkPassword" required>
            <p id="passwordMatch"></p>

            <div class="button-row">
                <button type="button" id="button51">Back</button>
                <button type="submit" id="createAccountBtn">
                    <span class="btn-label">Create account</span>
                    <span class="paw-track" aria-hidden="true">
                        <span class="paw">🐾</span>
                        <span class="paw">🐾</span>
                        <span class="paw">🐾</span>
                        <span class="paw">🐾</span>
                    </span>
                </button>                
            </div>
        </fieldset>

    </form>

    <script defer src="/script.js"></script>
</body>

</html>