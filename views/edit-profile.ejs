<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profiel bewerken</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="/profile.css">
</head>
<body>
    <div class="card">
        <h1>Profiel bewerken</h1>

        <form action="/edit-profile/<%= user._id %>" method="POST" enctype="multipart/form-data">

            <div class="form-group">
                <label>Naam</label>
                <input type="text" name="userName" value="<%= user.userName %>" required>
            </div>

            <div class="form-group">
                <label>Stad</label>
                <input type="text" name="userCity" value="<%= user.userCity %>">
            </div>

            <div class="form-group">
                <label>Telefoonnummer</label>
                <input type="tel" name="userPhone" value="<%= user.userPhone || '' %>">
            </div>

            <div class="form-group">
                <label>Hoe vaak speelafspraken?</label>
                <select name="isFrequency">
                    <option value="weekly" <%= user.isFrequency === 'weekly' ? 'selected' : '' %>>Wekelijks</option>
                    <option value="everyFewWeeks" <%= user.isFrequency === 'everyFewWeeks' ? 'selected' : '' %>>Elke paar weken</option>
                    <option value="occasionally" <%= user.isFrequency === 'occasionally' ? 'selected' : '' %>>Af en toe</option>
                    <option value="flexibel" <%= user.isFrequency === 'flexibel' ? 'selected' : '' %>>Flexibel</option>
                </select>
            </div>

            <div class="form-group">
                <label>Voorkeur ontmoetingsplaats</label>
                <select name="preferPlace">
                    <option value="isOutdoor" <%= user.preferPlace === 'isOutdoor' ? 'selected' : '' %>>Buiten</option>
                    <option value="isGarden" <%= user.preferPlace === 'isGarden' ? 'selected' : '' %>>Afgesloten tuin</option>
                    <option value="isHome" <%= user.preferPlace === 'isHome' ? 'selected' : '' %>>Thuis</option>
                    <option value="isCafe" <%= user.preferPlace === 'isCafe' ? 'selected' : '' %>>Dierenvriendelijk café</option>
                </select>
            </div>

            <hr>

            <div class="form-group">
                <label>Naam huisdier</label>
                <input type="text" name="petName" value="<%= animal ? animal.petName : '' %>">
            </div>

            <div class="form-group">
                <label>Soort dier</label>
                <select name="petType">
                    <option value="cat" <%= animal && animal.petType === 'cat' ? 'selected' : '' %>>Kat</option>
                    <option value="dog" <%= animal && animal.petType === 'dog' ? 'selected' : '' %>>Hond</option>
                </select>
            </div>

            <div class="form-group">
                <label>Ras</label>
                <input type="text" name="isBreed" value="<%= animal ? animal.petBreed : '' %>">
            </div>

            <div class="form-group">
                <label>Gewicht (kg)</label>
                <input type="number" name="isKilo" step="0.1" value="<%= animal ? animal.petWeight : '' %>">
            </div>

            <div class="form-group">
                <label>Foto huisdier</label>
                <input type="file" name="cover" accept="image/*">
            </div>

            <div class="actions">
                <button type="submit">Opslaan</button>
                <a href="/profile/<%= user._id %>">Annuleren</a>
            </div>

        </form>
    </div>
</body>
</html>