<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <title>Contact delen</title>
    <link rel="stylesheet" href="/static/style.css">
</head>

<body>

<div class="container">

    <h1>Nieuwe Match! 🐾</h1>
    <p>Jullie zijn gematcht! Deel je contactgegevens om een playdate te plannen.</p>

    <div class="match-box">

        <div class="profile">
            <img src="/static/images/hond.jpg" alt="Hond">
            <h3>Lisa & Max</h3>
        </div>

        <div class="heart">❤️</div>

        <div class="profile">
            <img src="/static/images/kat.jpg" alt="Kat">
            <h3>Tom & Luna</h3>
        </div>

    </div>

    <h2>Deel je contactgegevens</h2>

    <div class="buttons">

        <a class="btn whatsapp"
           href="https://wa.me/31612345678"
           target="_blank">
            WhatsApp
        </a>

        <a class="btn instagram"
           href="https://instagram.com"
           target="_blank">
            Instagram
        </a>

        <a class="btn email"
           href="mailto:lisa@email.com">
            Gmail
        </a>

    </div>

    <p class="tip">
        Tip: Deel alleen contactgegevens als jullie een playdate willen plannen!
    </p>

</div>

</body>
</html>