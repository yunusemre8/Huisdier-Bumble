<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Match scherm</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <main class="match-page">
    <section class="match-screen">
      <h1 class="match-title">You found your match!</h1>

      <div class="match-profiles">
        <article class="profile-card">
          <img src="/images/profile-1.jpg" alt="Profiel van Lisa" />
        </article>

        <div class="heart-circle">♥</div>

        <article class="profile-card">
          <img src="/images/profile-2.jpg" alt="Profiel van Emma" />
        </article>
      </div>

      <section class="contact-card">
        <h2>Deel je contactgegevens</h2>
        <p>
          Jullie zijn gematcht! Deel eenvoudig je contactgegevens en praat verder
          met Lisa over het plannen van een leuke playdate! Gebruik bijvoorbeeld:
        </p>

        <div class="contact-buttons">
          <a class="contact-button whatsapp" href="#">
            <span>Whatsapp</span>
            <span>&gt;</span>
          </a>

          <a class="contact-button gmail" href="#">
            <span>Gmail</span>
            <span>&gt;</span>
          </a>
        </div>
      </section>

      <a class="park-button" href="#">Find the perfect park 🐾</a>

      <div class="paw paw-left">🐾</div>
      <div class="paw paw-right">🐾</div>
      <div class="paw paw-bottom">🐾</div>

      <nav class="bottom-nav">
        <a href="/" aria-label="Home">☝</a>
        <a href="/contact" aria-label="Chat">💬</a>
        <a href="/profile" aria-label="Profiel">◯</a>
      </nav>
    </section>
  </main>
</body>
</html>