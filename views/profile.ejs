<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <meta name="description" content="User's profile page">
</head>

<body>

    <h1>Profile</h1>

    <% if (user.cover) { %>

        <img src="/upload/<%= user.cover %>" width="150">

        <% } %>

            <h2>User: <%= user.userNickname %>
            </h2>

            <p>Pet name: <%= user.petName %>
            </p>

            <a href="/register">Register again</a>

</body>

</html>