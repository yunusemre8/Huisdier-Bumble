<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="/profile.css">
</head>
<body>
    <div class="card">
        <div class="card-header">
            <h1>Profile</h1>
            <button class="settings-btn" id="settingsBtn">⚙️</button>
        </div>
        
        <div class="settings-menu" id="settingsMenu">
            <a href="/edit-profile/<%= user._id %>">Edit your profile</a>
            <a href="/add-pet/<%= user._id %>">🐾 Add another pet</a>
            <a href="/changePassword/<%= user._id %>">🔑 Change password</a>
            <button id="deleteAccountBtn">Delete your account</button>
        </div>

        <div class="user-info">
            <p class="name"><%= user.userName %></p>
            <p class="city">📍 <%= user.userCity %></p>
        </div>

        <% if (animal) { %>
        <div class="pet-info">
            <% if (animal.cover) { %>
                <img src="/upload/<%= animal.cover %>" alt="<%= animal.petName %>">
            <% } %>
            <div class="pet-details">
                <p class="pet-name"><%= animal.petName %></p>
                <p><%= animal.petType %> · <%= animal.petBreed %></p>
            </div>
        </div>
        <% } %>

        <div class="actions">
            <button id="locationBtn">Share your location</button>
            <a href="/register">Register again</a>
        </div>
    </div>
    <%- include('partials/footer', { user: user }) %>
    <script src="/profile.js"></script>
</body>
</html>