<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
</head>

<body>
    <fieldset>
        <legend>Login</legend>

        <label for="userEmail" id="userEmail">Your email address</label>
        <input type="email" name="userEmail" id="userEmail">

        <label for="isPassword">Create your password</label>
        <input type="password" id="isPassword" name="isPassword">
        <input type="password" id="checkPassword" name="checkPassword">
    </fieldset>
</body>

</html>